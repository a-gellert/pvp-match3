[bootstrap]
main_collection = /main/main.collectionc
render = /main/render/game.renderc

[script]
shared_state = 1

[display]
width = 540
height = 960
high_dpi = 1

[render]
clear_color_red = 0.067
clear_color_green = 0.082
clear_color_blue = 0.129
clear_color_alpha = 1.0

[graphics]
default_texture_min_filter = linear
default_texture_mag_filter = linear

[input]
game_binding = /input/game.input_bindingc

[android]
input_method = HiddenInputField

[html5]
scale_mode = stretch
wasm_streaming = 1
show_fullscreen_button = 0
show_made_with_defold = 0
cssfile = /main/html5/dark.css
heap_size = 96

[native_extension]
app_manifest = /main/game.appmanifest

[druid]
input_key_back = key_back
input_touch = touch
no_auto_input = 1

[project]
title = Gem Vanguard
version = 1.2.0
bundle_resources = /bundle_res
dependencies#0 = https://github.com/defold/extension-poki-sdk/archive/3e0c3296e6c4a27b99387d9c54d06626daa94b89.zip
dependencies#1 = https://github.com/Insality/defold-event/archive/refs/tags/21.zip
dependencies#2 = https://github.com/Insality/druid/archive/refs/tags/1.3.0.zip
