-- App controller: screens (Battle / Hub tabs), popups + queue, Druid layers, Poki SDK and input.

-- gui.pick_node multiplies the input point by (window size / project display size) even with
-- ADJUST_REFERENCE_DISABLED, while our nodes live in the virtual canvas. Wrap it so every hit test
-- (Druid buttons, scrolls, drags, blockers) takes virtual coordinates. Must run before Druid is
-- required: druid.helper caches gui.pick_node at load time.
local PICK = { kx = 1, ky = 1 }
local raw_pick_node = gui.pick_node
gui.pick_node = function(node, x, y)
	return raw_pick_node(node, x * PICK.kx, y * PICK.ky)
end

local ui = require "main.gui.ui"
local battle_view = require "main.gui.battle_view"
local hub_view = require "main.gui.hub_view"
local popups = require "main.gui.popups"
local layout = require "main.modules.layout"
local battle = require "main.modules.battle"
local campaign = require "main.modules.campaign"
local progress = require "main.modules.progress"
local quests = require "main.modules.quests"
local config = require "main.modules.config"
local poki = require "main.modules.poki"
local audio = require "main.modules.audio"
local i18n = require "main.modules.i18n"
local loader = require "main.modules.loader"

local TOUCH = hash("touch")
local TOUCH_MULTI = hash("touch_multi")

local app = { tab = "home", queue = {} }

-- ---------------------------------------------------------------- screens
local function fade_in_overlay()
	local n = ui.box(nil, "square", app.vw / 2, app.vh / 2, app.vw, app.vh, vmath.vector4(0.03, 0.04, 0.07, 1))
	gui.animate(n, "color.w", 0, gui.EASING_OUTQUAD, 0.28, 0, function() gui.delete_node(n) end)
end

function app.rebuild(with_fade)
	ui.gen = ui.gen + 1
	ui.popup_gen = ui.popup_gen + 1
	ui.close_layer("popup")
	ui.close_layer("screen")
	if app.screen_layer then gui.delete_node(app.screen_layer) end
	if app.popup_layer then gui.delete_node(app.popup_layer) end
	-- Every lazy texture watcher pointed at the nodes we just deleted; live nodes re-register below.
	loader.reset_watchers()
	app.popup_root = nil
	app.screen_layer = ui.pane(nil, 0, 0)
	app.popup_layer = ui.pane(nil, 0, 0)

	ui.open_layer("screen")
	ui.druid:new_back_handler(function() ui.defer(app.on_back) end)
	if app.screen == "battle" and app.session then
		audio.set_music("battle")
		battle_view.build(app, app.screen_layer)
	else
		app.screen = "hub"
		audio.set_music("hub")
		hub_view.build(app, app.screen_layer)
	end
	if app.popup then
		ui.open_layer("popup")
		popups.build(app, app.popup)
	end
	ui.set_layer("screen")
	if with_fade then fade_in_overlay() end
end

local function update_size()
	local w, h = window.get_size()
	if w == app.win_w and h == app.win_h then return false end
	app.win_w, app.win_h = w, h
	app.vw, app.vh, app.orient = layout.virtual_size(w, h)
	if w > 0 and h > 0 then
		PICK.kx, PICK.ky = (app.dw or 540) / w, (app.dh or 960) / h
	end
	return true
end

-- ---------------------------------------------------------------- popups
function app.open_popup(kind, data)
	if app.popup then app.close_popup(true) end
	app.popup = { kind = kind, data = data or {} }
	ui.open_layer("popup")
	popups.build(app, app.popup)
	ui.set_layer("screen")
end

function app.close_popup(keep_queue)
	ui.close_layer("popup")
	if app.popup_root then gui.delete_node(app.popup_root) end
	ui.popup_gen = ui.popup_gen + 1
	app.popup_root = nil
	app.popup = nil
	ui.set_layer("screen")
	if not keep_queue then app.next_popup() end
end

-- Rebuild the screen under a new popup (e.g. card upgraded -> level up): drop the current popup first
-- so it is not rebuilt and then immediately replaced within the same frame.
function app.refresh_then_popup(kind, data)
	app.popup = nil
	app.rebuild()
	app.open_popup(kind, data)
end

-- Popups that should appear one after another (rewards, league up, daily calendar...)
function app.queue_popup(kind, data)
	app.queue[#app.queue + 1] = { kind = kind, data = data }
	if not app.popup then app.next_popup() end
end

function app.next_popup()
	if app.popup or #app.queue == 0 then return end
	local p = table.remove(app.queue, 1)
	app.open_popup(p.kind, p.data)
end

function app.on_back()
	if app.popup then
		popups.on_back(app)
	elseif app.screen == "battle" then
		app.pause()
	elseif app.tab ~= "home" then
		app.set_tab("home")
	else
		app.open_popup("settings")
	end
end

-- ---------------------------------------------------------------- navigation
function app.show_hub(tab)
	app.paused_gameplay = nil
	poki.gameplay_stop()
	app.screen = "hub"
	app.session = nil
	app.tab = tab or app.tab or "home"
	progress.tick_day()
	app.rebuild(true)
	app.hub_entered()
end

function app.set_tab(tab)
	if app.tab == tab and app.screen == "hub" then return end
	app.tab = tab
	audio.play("whoosh", 0.5)
	app.rebuild(true)
end

-- Things that pop up when the player arrives in the hub.
function app.hub_entered()
	if progress.data.onboarding_done and quests.login_pending(progress.data) then
		app.queue_popup("daily")
	end
end

local function battle_opts(base)
	local d = progress.data
	base.player_hp = progress.hero_hp()
	base.player_moves = d.max_moves
	base.heal_power = progress.heal_power()
	base.shield_power = progress.shield_power()
	base.player_squads = progress.player_slots_for_battle()
	base.boosters = d.boosters
	return base
end

function app.start_campaign(stage_id, skip_break)
	local function go()
		local stg = campaign.get_stage(stage_id)
		local d = progress.data
		app.last_fight = { mode = "campaign", stage_id = stage_id }
		app.session = battle.new(battle_opts({
			mode = "campaign",
			stage_id = stg.id,
			arena = campaign.biome(stg.id).arena,
			board_cfg = stg.board_cfg,
			tutorial = stg.tutorial and not d.onboarding_done,
			seed = os.time() + stg.id * 31,
			enemy_name_key = stg.name_key,
			enemy_face = stg.face,
			enemy_hp = stg.hp,
			enemy_moves = stg.moves,
			enemy_diff = stg.diff,
			enemy_squads = stg.squads,
		}))
		app.screen = "battle"
		app.popup = nil
		app.queue = {}
		app.paused_gameplay = nil
		app.rebuild(true)
		poki.measure("battle", "campaign_" .. stg.id, "start")
	end
	if skip_break or config.VIDEO_MODE or not progress.data.onboarding_done then go() else poki.commercial_break((progress.data.stats.battles or 0) + 1, go) end
end

function app.start_pvp_search()
	local d = progress.data
	local opp = campaign.pvp_opponent(d.prestige, os.time(), progress.player_power())
	app.open_popup("pvp_search", { opp = opp })
end

function app.launch_pvp(opp)
	local d = progress.data
	local function go()
		app.last_fight = { mode = "pvp", opp = opp }
		app.session = battle.new(battle_opts({
			mode = "pvp",
			stage_id = 0,
			arena = opp.arena,
			board_cfg = opp.board_cfg,
			seed = os.time() + (d.prestige or 0),
			enemy_name = opp.name,
			enemy_face = opp.face,
			enemy_hp = opp.hp,
			enemy_moves = opp.moves,
			enemy_diff = opp.diff,
			enemy_squads = opp.squads,
			tint = config.LEAGUES[config.league_index(d.prestige)].color,
		}))
		app.screen = "battle"
		app.popup = nil
		app.queue = {}
		app.paused_gameplay = nil
		app.rebuild(true)
		poki.measure("battle", "pvp", "start")
	end
	if config.VIDEO_MODE then go() else poki.commercial_break((d.stats.battles or 0) + 1, go) end
end

-- Daily Trial: today's boss (see campaign.trial_boss); retries are free, the reward is once a day.
function app.start_trial()
	local d = progress.data
	local boss = progress.trial_boss()
	local function go()
		app.last_fight = { mode = "trial", opp = boss }
		app.session = battle.new(battle_opts({
			mode = "trial",
			stage_id = 0,
			arena = boss.arena,
			board_cfg = boss.board_cfg,
			seed = os.time() + 777,
			enemy_name_key = boss.name_key,
			enemy_face = boss.face,
			enemy_hp = boss.hp,
			enemy_moves = boss.moves,
			enemy_diff = boss.diff,
			enemy_squads = boss.squads,
			tint = campaign.BIOMES[boss.biome].tint,
		}))
		app.screen = "battle"
		app.popup = nil
		app.queue = {}
		app.paused_gameplay = nil
		app.rebuild(true)
		poki.measure("battle", "trial", "start")
	end
	if config.VIDEO_MODE then go() else poki.commercial_break((d.stats.battles or 0) + 1, go) end
end

-- ---------------------------------------------------------------- battle results
local function persist_boosters(s)
	for k, v in pairs(s.boosters) do progress.data.boosters[k] = v end
	progress.save()
end

local function result_opts(won)
	local s = app.session
	local stg = s.mode == "campaign" and campaign.get_stage(s.stage_id) or app.last_fight.opp
	return {
		won = won,
		is_pvp = s.mode == "pvp",
		is_trial = s.mode == "trial",
		diamonds = stg and stg.diamonds,
		stage_id = s.mode == "campaign" and s.stage_id or nil,
		gold = stg and stg.gold or 45,
		chest = stg and stg.chest or "wood",
		tutorial = s.tutorial,
		stats = s.stats,
		hp_ratio = battle.hp_ratio(s),
	}
end

function app.on_battle_end(won)
	app.paused_gameplay = nil
	poki.gameplay_stop()
	local s = app.session
	if not s then return end
	persist_boosters(s)
	if won then
		local res = progress.apply_battle_result(result_opts(true))
		res.stats = s.stats
		poki.measure("battle", s.mode, "win")
		app.open_popup("win", res)
	else
		-- Loss is applied only when the player leaves (a revive keeps the fight going).
		local opts = result_opts(false)
		local is_pvp = opts.is_pvp
		app.pending_loss = opts
		poki.measure("battle", s.mode, "lose")
		app.open_popup("lose", {
			gold = math.floor(opts.gold * 0.25),
			prestige_delta = opts.is_trial and 0 or -(is_pvp and config.PVP_PRESTIGE_LOSE or config.PRESTIGE_LOSE),
			can_revive = not s.revived,
		})
	end
end

function app.apply_pending_loss()
	if app.pending_loss then
		progress.apply_battle_result(app.pending_loss)
		app.pending_loss = nil
	end
end

function app.leave_battle(tab)
	app.apply_pending_loss()
	app.close_popup(true)
	app.show_hub(tab or "home")
end

function app.retry_battle()
	app.apply_pending_loss()
	app.close_popup(true)
	if not app.last_fight then app.show_hub(); return end
	if app.last_fight.mode == "pvp" then
		app.start_pvp_search()
	elseif app.last_fight.mode == "trial" then
		app.start_trial()
	else
		app.start_campaign(app.last_fight.stage_id)
	end
end

function app.next_stage()
	local nxt = math.min(campaign.COUNT, (progress.data.max_stage_unlocked or 1))
	app.close_popup(true)
	app.start_campaign(nxt, not progress.data.onboarding_done)
end

-- ---------------------------------------------------------------- rewarded ads
function app.reward_double_gold(data)
	poki.rewarded("medium", function(ok)
		if ok and not data.doubled then
			data.doubled = true
			progress.data.gold = progress.data.gold + (data.gold or 0)
			data.gold = (data.gold or 0) * 2
			progress.save()
			app.open_popup("win", data)
		end
	end)
end

function app.reward_second_chance()
	poki.rewarded("medium", function(ok)
		if ok and app.session and battle.revive_player(app.session) then
			app.pending_loss = nil
			app.close_popup(true)
			app.rebuild()
			poki.gameplay_start()
		end
	end)
end

function app.buy_booster_ad(kind)
	poki.rewarded("small", function(ok)
		if ok and app.session then
			app.session.boosters[kind] = (app.session.boosters[kind] or 0) + 1
			progress.data.boosters[kind] = app.session.boosters[kind]
			progress.save()
			battle_view.refresh_hud()
		end
	end)
end

function app.pause()
	if app.popup then return end
	if app.screen == "battle" then
		app.paused_gameplay = poki.is_gameplay()
		poki.gameplay_stop()
		app.open_popup("pause")
	else
		app.open_popup("settings")
	end
end

function app.resume_battle()
	local was_playing = app.paused_gameplay
	app.paused_gameplay = nil
	app.close_popup()
	if was_playing and not app.popup then poki.gameplay_start() end
end

-- ---------------------------------------------------------------- lifecycle
local function debug_setup(ds)
	local d = progress.data
	if ds == "" then return false end
	d.onboarding_step = 2
	d.onboarding_done = true
	d.gold, d.diamonds = 1450, 220
	d.prestige, d.max_prestige = 340, 360
	d.max_stage_unlocked = 9
	d.stars = { 3, 3, 2, 3, 1, 2, 3, 2 }
	d.cards.red_militia.count = 5
	d.cards.red_wolves.unlocked = true
	d.cards.red_wolves.new = true
	d.cards.purple_necro.unlocked = true
	progress.add_chest("wood")
	local s2 = progress.add_chest("silver")
	if s2 then progress.start_chest(s2) end
	progress.add_chest("royal")
	d.streak = 3
	if ds ~= "daily" then d.login.last_day = quests.today() end
	if ds == "home" or ds == "hub" then app.show_hub("home")
	elseif ds == "cards" or ds == "map" or ds == "shop" or ds == "quests" then app.show_hub(ds)
	elseif ds == "battle" then app.start_campaign(7, true)
	elseif ds == "pvp" then app.launch_pvp(campaign.pvp_opponent(d.prestige, 5, progress.player_power()))
	elseif ds == "chest" then app.show_hub("home"); app.open_popup("chest", progress.roll_chest("royal", 77))
	elseif ds == "win" then
		app.start_campaign(7, true)
		app.open_popup("win", { won = true, gold = 124, prestige_delta = 25, chest_rarity = "silver", chest_slot = 4, stars = 3, new_stars = 3, stage_id = 7, stats = app.session.stats })
	elseif ds == "daily" then app.show_hub("home")
	elseif ds == "trial" then app.show_hub("home"); app.open_popup("trial")
	elseif ds == "trial_battle" then app.start_trial()
	elseif ds == "trial_win" then
		app.start_trial()
		app.open_popup("win", { won = true, gold = 290, is_trial = true, trial = { diamonds = 12, streak = 2 }, chest_rarity = "silver", chest_slot = 4, stats = app.session.stats })
	elseif ds == "road" then app.show_hub("home"); app.open_popup("road")
	elseif ds == "stage" then app.show_hub("map"); app.open_popup("stage", { id = 9 })
	elseif ds == "sim" then
		local rng = require "main.modules.rng"
		local ai = require "main.modules.ai"
		local tot_w, tot_n = 0, 0
		for n = 1, campaign.COUNT do
			local stg = campaign.get_stage(n)
			local lvl, moves, hp = campaign.expected_build(n)
			local wins, turns, N = 0, 0, 40
			for s_i = 1, N do
				local s = battle.new({
					mode = "campaign", stage_id = n, seed = n * 1009 + s_i * 37,
					board_cfg = stg.board_cfg,
					player_hp = hp, player_moves = moves,
					heal_power = math.floor(hp * config.HEAL_RATIO + 0.5),
					shield_power = math.floor(hp * config.SHIELD_RATIO + 0.5),
					player_squads = {
						red = { id = "red_militia", level = lvl },
						yellow = { id = "yellow_archers", level = lvl },
						purple = { id = "purple_cultists", level = lvl },
					},
					enemy_hp = stg.hp, enemy_moves = stg.moves, enemy_diff = stg.diff, enemy_squads = stg.squads,
				})
				while s.status == "play" and s.turn_num <= 25 do
					if s.turn == "player" then
						local m = ai.pick_move(s.board, s.player, 2, s.rng)
						if m then battle.player_swap(s, m.r1, m.c1, m.r2, m.c2) else s.turn = "enemy" end
						s.events = {}
					else
						battle.step_enemy(s)
						s.events = {}
					end
				end
				if s.status == "win" then wins = wins + 1 end
				turns = turns + s.turn_num
			end
			tot_w, tot_n = tot_w + wins, tot_n + N
			print(string.format("[SIM] stage=%d%s win=%d%% turns=%.1f php=%d pmv=%d ehp=%d emv=%d",
				n, stg.boss and "(B)" or "", math.floor(wins * 100 / N), turns / N, hp, moves, stg.hp, stg.moves))
		end
		print(string.format("[SIM] TOTAL win=%d%%", math.floor(tot_w * 100 / tot_n)))
		app.show_hub("home")
	else return false end
	return true
end

function init(self)
	msg.post(".", "acquire_input_focus")
	math.randomseed(os.time())
	ui.init(self)
	quests.time_offset = sys.get_config_int("pvp.time_offset", 0)
	battle_view.autoplay = sys.get_config_int("pvp.autoplay", 0) == 1
	progress.load(sys.get_config_int("pvp.fresh", 0) == 1)
	local force_lang = sys.get_config_string("pvp.lang", "")
	if force_lang ~= "" then progress.data.lang = force_lang end
	i18n.set(progress.data.lang ~= "" and progress.data.lang or i18n.detect())
	audio.set(progress.data.sound, progress.data.music)
	app.dw = sys.get_config_int("display.width", 540)
	app.dh = sys.get_config_int("display.height", 960)
	update_size()
	loader.start()
	timer.delay(0.45, false, function()
		audio.load_deferred(loader.base_url())
	end)

	local ds = sys.get_config_string("pvp.debug_screen", "")
	if debug_setup(ds) then return end
	if not progress.data.onboarding_done and progress.data.onboarding_step == 0 then
		app.start_campaign(math.min(config.ONBOARDING_BATTLES, progress.data.max_stage_unlocked or 1), true)
	else
		app.show_hub("home")
	end
end

function update(self, dt)
	audio.update(dt)
	if update_size() then app.resize_t = 0.12 end
	if app.resize_t then
		app.resize_t = app.resize_t - dt
		if app.resize_t <= 0 then
			app.resize_t = nil
			app.rebuild()
		end
	end
	if poki.is_ad_active() then return end
	ui.update(dt)
	if app.screen == "battle" then
		if not app.popup then battle_view.update(dt) end
	else
		hub_view.update(dt)
	end
end

function on_input(self, action_id, action)
	if poki.is_ad_active() then return true end
	local kx, ky = app.vw / app.dw, app.vh / app.dh
	if action.x then
		-- Druid hit-tests with gui.pick_node; our GUI lives in the virtual canvas
		-- (adjust reference disabled), so convert screen -> virtual units once here.
		action.x, action.y = action.x * kx, action.y * ky
		if action.dx then action.dx, action.dy = action.dx * kx, action.dy * ky end
	end
	if action.touch then
		for i = 1, #action.touch do
			local t = action.touch[i]
			if t.x then t.x, t.y = t.x * kx, t.y * ky end
			if t.dx then t.dx, t.dy = t.dx * kx, t.dy * ky end
		end
		if not action.x and action.touch[1] then
			action.x, action.y = action.touch[1].x, action.touch[1].y
		end
	end
	local pressed = action.pressed or (action.touch and action.touch[1] and action.touch[1].pressed)
	if (action_id == TOUCH or action_id == TOUCH_MULTI) and pressed then audio.start_music() end
	if app.screen == "battle" and not app.popup then
		battle_view.on_raw_input(action_id, action)
	end
	local layer = app.popup and "popup" or "screen"
	local d = ui.layers[layer]
	if d then
		local prev = ui.layer
		ui.set_layer(layer)
		d:on_input(action_id, action)
		ui.set_layer(prev)
	end
	return true
end

function final(self)
	ui.close_layer("popup")
	ui.close_layer("screen")
end
