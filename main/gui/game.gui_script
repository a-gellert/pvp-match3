-- App controller: screens (Battle / Hub / Map / Shop), Popups, Poki SDK & input.
local ui = require "main.gui.ui"
local battle_view = require "main.gui.battle_view"
local hub_view = require "main.gui.hub_view"
local map_view = require "main.gui.map_view"
local shop_view = require "main.gui.shop_view"
local popups = require "main.gui.popups"
local layout = require "main.modules.layout"
local battle = require "main.modules.battle"
local campaign = require "main.modules.campaign"
local progress = require "main.modules.progress"
local poki = require "main.modules.poki"
local audio = require "main.modules.audio"
local i18n = require "main.modules.i18n"

local TOUCH = hash("touch")
local BACK = hash("back")

local app = {}

function app.rebuild()
	ui.gen = ui.gen + 1
	ui.buttons = {}
	app.pressed = nil
	if app.screen_layer then gui.delete_node(app.screen_layer) end
	if app.popup_layer then gui.delete_node(app.popup_layer) end
	app.screen_layer = ui.pane(nil, 0, 0)
	app.popup_layer = ui.pane(nil, 0, 0)
	ui.layer = "screen"
	if app.screen == "battle" and app.session then
		battle_view.build(app, app.screen_layer)
	elseif app.screen == "map" then
		map_view.build(app, app.screen_layer)
	elseif app.screen == "shop" then
		shop_view.build(app, app.screen_layer)
	else
		hub_view.build(app, app.screen_layer)
	end
	if app.popup then
		ui.layer = "popup"
		popups.build(app, app.popup)
		ui.layer = "screen"
	end
end

local function update_size()
	local w, h = window.get_size()
	if w == app.win_w and h == app.win_h then return false end
	app.win_w, app.win_h = w, h
	app.vw, app.vh, app.orient = layout.virtual_size(w, h)
	return true
end

function app.open_popup(kind, data)
	if app.popup then app.close_popup() end
	app.popup = { kind = kind, data = data }
	ui.layer = "popup"
	popups.build(app, app.popup)
	ui.layer = "screen"
end

function app.close_popup()
	if app.popup_root then gui.delete_node(app.popup_root) end
	ui.popup_gen = ui.popup_gen + 1
	app.popup_root = nil
	app.popup = nil
	app.pressed = nil
	ui.remove_buttons("popup")
end

function app.show_hub()
	poki.gameplay_stop()
	app.screen = "hub"
	app.session = nil
	app.rebuild()
end

function app.show_map()
	poki.gameplay_stop()
	app.screen = "map"
	app.session = nil
	app.rebuild()
end

function app.show_shop()
	poki.gameplay_stop()
	app.screen = "shop"
	app.session = nil
	app.rebuild()
end

function app.start_campaign(stage_id, skip_break)
	local function go()
		local stg = campaign.get_stage(stage_id)
		local d = progress.data
		app.last_fight = { mode = "campaign", stage_id = stage_id }
		app.session = battle.new({
			mode = "campaign",
			stage_id = stg.id,
			tutorial = stg.tutorial and not d.onboarding_done,
			seed = os.time() + stg.id * 31,
			player_hp = progress.hero_hp(),
			player_moves = d.max_moves,
			heal_power = progress.heal_power(),
			shield_power = progress.shield_power(),
			player_squads = progress.player_slots_for_battle(),
			enemy_name_key = stg.name_key,
			enemy_face = stg.face,
			enemy_hp = stg.hp,
			enemy_moves = stg.moves,
			enemy_diff = stg.diff,
			enemy_squads = stg.squads,
			boosters = d.boosters,
		})
		app.screen = "battle"
		app.popup = nil
		app.rebuild()
	end
	if skip_break then go() else poki.commercial_break(stage_id, go) end
end

function app.start_pvp_search()
	local opp = campaign.pvp_opponent(progress.data.prestige, os.time())
	app.open_popup("pvp_search", { opp = opp })
end

function app.launch_pvp(opp)
	local d = progress.data
	app.last_fight = { mode = "pvp", opp = opp }
	app.session = battle.new({
		mode = "pvp",
		stage_id = 0,
		seed = os.time() + (d.prestige or 0),
		player_hp = progress.hero_hp(),
		player_moves = d.max_moves,
		heal_power = progress.heal_power(),
		shield_power = progress.shield_power(),
		player_squads = progress.player_slots_for_battle(),
		enemy_name = opp.name,
		enemy_face = opp.face,
		enemy_hp = opp.hp,
		enemy_moves = opp.moves,
		enemy_diff = opp.diff,
		enemy_squads = opp.squads,
		boosters = d.boosters,
	})
	app.screen = "battle"
	app.rebuild()
end

function app.retry_battle()
	if not app.last_fight then app.show_hub(); return end
	if app.last_fight.mode == "pvp" then
		app.launch_pvp(app.last_fight.opp)
	else
		app.start_campaign(app.last_fight.stage_id)
	end
end

function app.on_battle_end(won)
	poki.gameplay_stop()
	local s = app.session
	if not s then return end
	-- Persist remaining boosters
	for k, v in pairs(s.boosters) do progress.data.boosters[k] = v end

	local stg = s.mode == "campaign" and campaign.get_stage(s.stage_id) or app.last_fight.opp
	local res = progress.apply_battle_result({
		won = won,
		is_pvp = s.mode == "pvp",
		stage_id = s.stage_id,
		gold = stg and stg.gold or 45,
		chest = stg and stg.chest or "wood",
		tutorial = s.tutorial,
	})
	app.open_popup(won and "win" or "lose", res)
end

function app.reward_double_gold(data)
	poki.rewarded("medium", function(ok)
		if ok and not data.doubled then
			data.doubled = true
			progress.data.gold = progress.data.gold + (data.gold or 0)
			data.gold = (data.gold or 0) * 2
			progress.save()
			app.open_popup("win", data)
		end
	end)
end

function app.reward_second_chance()
	poki.rewarded("medium", function(ok)
		if ok and app.session then
			battle.revive_player(app.session)
			app.close_popup()
			app.rebuild()
			poki.gameplay_start()
		end
	end)
end

function app.buy_booster_ad(kind)
	poki.rewarded("small", function(ok)
		if ok and app.session then
			app.session.boosters[kind] = (app.session.boosters[kind] or 0) + 1
			progress.data.boosters[kind] = app.session.boosters[kind]
			progress.save()
			app.rebuild()
		end
	end)
end

function app.pause()
	if app.popup then return end
	if app.screen == "battle" then
		poki.gameplay_stop()
		app.open_popup("pause")
	else
		app.open_popup("settings")
	end
end

function init(self)
	msg.post(".", "acquire_input_focus")
	math.randomseed(os.time())
	progress.load(sys.get_config_int("pvp.fresh", 0) == 1)
	local force_lang = sys.get_config_string("pvp.lang", "")
	if force_lang ~= "" then progress.data.lang = force_lang end
	i18n.set(progress.data.lang ~= "" and progress.data.lang or i18n.detect())
	audio.set(progress.data.sound, progress.data.music)
	app.dw = sys.get_config_int("display.width", 540)
	app.dh = sys.get_config_int("display.height", 960)
	update_size()

	local ds = sys.get_config_string("pvp.debug_screen", "")
	if ds == "hub" then
		progress.add_chest("wood")
		local s2 = progress.add_chest("silver")
		if s2 then progress.start_chest(s2) end
		progress.add_chest("royal")
		progress.data.cards.red_militia.count = 2
		progress.data.onboarding_step = 1
		app.show_hub()
	elseif ds == "map" then
		app.show_map()
	elseif ds == "shop" then
		app.show_shop()
	elseif ds == "battle_fx" then
		app.start_campaign(1, true)
		app.session.tutorial = false
		app.rebuild()
		local function pulse_fx()
			if app.screen ~= "battle" then return end
			local evs = app.session.events
			local sq_r = app.session.player.squads.red
			if sq_r then sq_r.rune_filled[1] = true end
			evs[#evs + 1] = { kind = "rune", who = "player", color = "red", slot = 1, rune_color = "red" }
			evs[#evs + 1] = { kind = "attack", who = "player", color = "yellow", dmg = 14, style = "ranged", fx = "proj_arrow", units = 4 }
			evs[#evs + 1] = { kind = "skill", who = "player", color = "purple", skill_id = "meteor_storm", style = "magic", fx = "proj_fire", units = 3, dmg = 28, dealt = 28, blocked = 0, effect = "burn" }
			evs[#evs + 1] = { kind = "status", who = "enemy", stype = "burn", val = 6 }
			evs[#evs + 1] = { kind = "attack", who = "player", color = "red", dmg = 9, style = "melee", fx = "fx_slash", units = 4 }
			battle_view.process()
			ui.after(0.85, pulse_fx)
		end
		ui.after(0.35, pulse_fx)
	elseif ds == "battle" or (not progress.data.onboarding_done and progress.data.onboarding_step == 0) then
		app.start_campaign(1, true)
	else
		app.show_hub()
	end
end

function update(self, dt)
	audio.update(dt)
	if update_size() then app.resize_t = 0.1 end
	if app.resize_t then
		app.resize_t = app.resize_t - dt
		if app.resize_t <= 0 then
			app.resize_t = nil
			app.rebuild()
		end
	end
	if poki.is_ad_active() then return end
	if app.screen == "battle" and not app.popup then
		battle_view.update(dt)
	elseif app.screen == "hub" and not app.popup then
		hub_view.update(dt)
	end
end

local function to_virtual(action)
	return action.x / app.dw * app.vw, action.y / app.dh * app.vh
end

function on_input(self, action_id, action)
	if poki.is_ad_active() then return true end
	if action_id == TOUCH then
		local x, y = to_virtual(action)
		local layer = app.popup and "popup" or "screen"
		if action.pressed then
			local b = ui.find_button(x, y, layer)
			if b then
				app.pressed = b
				ui.press(b)
			elseif app.screen == "battle" and not app.popup then
				if battle_view.tap(x, y, true, false) then poki.gameplay_start() end
			end
		elseif action.released then
			if app.pressed then
				local b = app.pressed
				app.pressed = nil
				ui.release(b, ui.find_button(x, y, layer) == b)
			elseif app.screen == "battle" and not app.popup then
				if battle_view.tap(x, y, false, true) then poki.gameplay_start() end
			end
		end
		return true
	elseif action_id == BACK and action.pressed then
		if app.popup then
			app.close_popup()
		else
			app.pause()
		end
		return true
	end
end
